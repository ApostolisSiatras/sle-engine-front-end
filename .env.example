# OpenAI-compatible local server, for example LM Studio or Ollama's OpenAI API.
# This value is read by Vite's local development proxy, never shipped to the browser.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234
LOCAL_LLM_API_PATH=/v1/chat/completions
LOCAL_LLM_MODEL=local-model

# Optional only when your *local* server requires authentication.
# Do not use a cloud-provider credential in this prototype.
# LOCAL_LLM_API_KEY=
